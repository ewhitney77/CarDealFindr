# Copy this file to .env and fill in the keys. .env is git-ignored.

# MarketCheck (primary). Sign up at https://developers.marketcheck.com/ -> create an app -> copy the API key.
MARKETCHECK_API_KEY=

# Apify (CarGurus IMV + deal ratings). https://console.apify.com/account/integrations -> Personal API tokens.
# Only used when APIFY_ENABLED=True in config.py or `run --apify`. Billed per listing.
APIFY_TOKEN=

# Auto.dev (free cross-check). https://www.auto.dev/ -> sign up -> API key.
AUTODEV_API_KEY=
